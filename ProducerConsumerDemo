import java.util.LinkedList;

class PC {
    // Shared buffer with a fixed capacity
    private final LinkedList<Integer> buffer = new LinkedList<>();
    private final int capacity = 2;
    private int value = 0;

    // Method called by the producer thread
    public void produce() throws InterruptedException {
        while (true) {
            synchronized (this) {
                // Wait if the buffer is full (Using while loop to avoid spurious wake-ups)
                while (buffer.size() == capacity) {
                    wait();
                }

                System.out.println("Producer produced-" + value);
                buffer.add(value++);

                // Notify the consumer that an item is available
                notify();
            }
            // Sleep outside the synchronized block to allow thread context switching
            Thread.sleep(1000);
        }
    }

    // Method called by the consumer thread
    public void consume() throws InterruptedException {
        while (true) {
            synchronized (this) {
                // Wait if the buffer is empty (Using while loop to avoid spurious wake-ups)
                while (buffer.size() == 0) {
                    wait();
                }

                int val = buffer.removeFirst();
                System.out.println("Consumer consumed-" + val);

                // Notify the producer that space has cleared up
                notify();
            }
            // Sleep outside the synchronized block to allow thread context switching
            Thread.sleep(1000);
        }
    }
}

public class ProducerConsumerDemo {
    public static void main(String[] args) {
        PC pcInstance = new PC();

        // Create the Producer thread
        Thread producerThread = new Thread(() -> {
            try {
                pcInstance.produce();
            } catch (InterruptedException e) {
                System.err.println("Producer thread interrupted.");
            }
        });

        // Create the Consumer thread
        Thread consumerThread = new Thread(() -> {
            try {
                pcInstance.consume();
            } catch (InterruptedException e) {
                System.err.println("Consumer thread interrupted.");
            }
        });

        // Start both threads
        producerThread.start();
        consumerThread.start();

        try {
            // Join threads to the main execution flow
            producerThread.join();
            consumerThread.join();
        } catch (InterruptedException e) {
            System.err.println("Main thread interrupted.");
        }
    }
}
